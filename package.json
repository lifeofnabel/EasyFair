{
  "name": "jajehelp-messe-organizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jajehelp Messe Organizer: capture products at trade fairs, review and decide at home.",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --port 5175 --mode live",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start --project demo-jajehelp",
    "emulator:admin": "node scripts/emulator-admin.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-jajehelp \"vitest run --config vitest.rules.config.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
