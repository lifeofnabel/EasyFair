# Jajehelp Messe Organizer - copy to .env.local (gitignored) only if you need to override something.
# None of these are secrets: the Firebase web config is public by design,
# access is enforced by firestore.rules + the Jajehelp admin claim.
# Defaults: `npm run dev` = local-only, `npm run dev:live` / production build = jajehelp37.

# off | emulator | live
# VITE_FIREBASE_MODE=off

# Overrides (defaults = jajehelp37 public web config)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Claude API key and Cloudinary settings are NOT env vars.
# Enter them in the app under Settings (stored in your private Firebase profile).
# Never put the Firebase service-account JSON or the Cloudinary API secret in this folder.
